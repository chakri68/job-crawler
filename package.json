{
  "name": "job-cron",
  "version": "0.1.0",
  "description": "Watches official career pages and alerts on new matching jobs; on-demand resume tailoring via headless Claude.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "job-cron": "src/cli.ts"
  },
  "scripts": {
    "run": "node src/cli.ts run",
    "list": "node src/cli.ts list",
    "sources": "node src/cli.ts sources",
    "tailor": "node src/cli.ts tailor",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
